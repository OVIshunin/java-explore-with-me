          "name": "0.1 Создать администратора",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус ответа 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Администратор создан', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('name', pm.variables.get('adminUserName'));",
                  "    pm.expect(jsonData).to.have.property('email', pm.variables.get('adminUserEmail'));",
                  "});",
                  "",
                  "pm.environment.set('adminUserId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{adminUserName}}\",\n    \"email\": \"{{adminUserEmail}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/admin/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "users"]
